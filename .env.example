# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development

# Database. Leave empty in Phase 1 to use SQLite. From Phase 2:
# DATABASE_URL=postgres://cds_user:cds_password@localhost:5432/cds
DATABASE_URL=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# JWT (used from Phase 3)
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# AI provider (used from Phase 6). Never commit real keys.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Optional live medical web search (Tavily is the only supported provider).
# Without these the AI answers from the built-in corpus only, and the backend
# logs a warning that live trusted search is disabled.
# To enable: get a key at https://app.tavily.com, then set both lines below.
# Results are restricted to these domains before they reach the AI.
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=
WEB_SEARCH_ALLOWED_DOMAINS=who.int,moh.gov.rw,rfd.gov.rw,cdc.gov,nih.gov,nhs.uk,mayoclinic.org

# Embeddings / RAG (used from Phase 7)
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_BACKEND=pgvector

# Email / SMTP. Used to send password-reset verification codes.
# If EMAIL_HOST or EMAIL_HOST_PASSWORD is empty, Django falls back to the
# console backend and prints codes to the server log instead of emailing them.
#
# Verify any configuration with:
#   python manage.py check_email you@your-inbox.com
# It prints the SMTP transcript and distinguishes "relay accepted it" from
# "it reached the inbox". Restart runserver after editing this file - Django's
# autoreloader watches .py only, so a running server keeps the old backend.
#
# IMPORTANT: To avoid emails being flagged as spam, you MUST configure:
# 1. SPF record in your DNS (e.g., "v=spf1 include:your-smtp-provider.com ~all")
# 2. DKIM signing (configured in your email provider's dashboard)
# 3. DMARC policy (e.g., "v=DMARC1; p=none; rua=mailto:dmarc@yourdomain.com")
#
# --- Option A: Brevo (recommended; 300/day free, has delivery logs) ---------
# Create an account at https://www.brevo.com, then Transactional Email >
# Settings > SMTP & API > SMTP key > generate. Validate your sender address
# under Senders & Domains. EMAIL_HOST_PASSWORD is the SMTP key, NOT your
# Brevo account password. EMAIL_HOST_USER is your Brevo login email.
#
#   EMAIL_HOST=smtp-relay.brevo.com
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=true
#   EMAIL_HOST_USER=you@your-brevo-login.com
#   EMAIL_HOST_PASSWORD=your-brevo-smtp-key
#   DEFAULT_FROM_EMAIL=you@your-brevo-login.com
#
# --- Option B: Gmail ---------------------------------------------------------
# EMAIL_HOST_USER and DEFAULT_FROM_EMAIL must both be the Gmail account
# that authenticates, and EMAIL_HOST_PASSWORD must be a 16-character App
# Password (Google Account > Security > 2-Step Verification > App passwords).
# A normal Gmail password has been rejected since May 2022.
#
# Gmail works but is a poor fit for transactional mail: ~500/day cap, no
# delivery logs, and Google accepts messages at RCPT TO time that it then
# discards silently, so a 250 response does not prove the inbox exists.
# Brevo's dashboard shows why a message bounced; Gmail shows you nothing.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=your-sender@gmail.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=your-sender@gmail.com
EMAIL_TIMEOUT=30
EMAIL_HOSTNAME=

# Identity used inside the reset email. Setting SUPPORT_EMAIL also adds a
# List-Unsubscribe header, which Gmail and Yahoo treat as a trust signal.
SITE_URL=
SUPPORT_EMAIL=
