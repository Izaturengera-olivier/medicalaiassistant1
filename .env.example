# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development

# Database. Leave empty in Phase 1 to use SQLite. From Phase 2:
# DATABASE_URL=postgres://cds_user:cds_password@localhost:5432/cds
DATABASE_URL=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# JWT (used from Phase 3)
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# AI provider (used from Phase 6). Never commit real keys.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Optional live medical web search (Tavily is the only supported provider).
# Without these the AI answers from the built-in corpus only, and the backend
# logs a warning that live trusted search is disabled.
# To enable: get a key at https://app.tavily.com, then set both lines below.
# Results are restricted to these domains before they reach the AI.
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=
WEB_SEARCH_ALLOWED_DOMAINS=who.int,moh.gov.rw,rfd.gov.rw,cdc.gov,nih.gov,nhs.uk,mayoclinic.org

# Embeddings / RAG (used from Phase 7)
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_BACKEND=pgvector
