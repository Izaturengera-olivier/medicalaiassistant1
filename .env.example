# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development

# Database. Leave empty in Phase 1 to use SQLite. From Phase 2:
# DATABASE_URL=postgres://cds_user:cds_password@localhost:5432/cds
DATABASE_URL=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# JWT (used from Phase 3)
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# AI provider (used from Phase 6). Never commit real keys.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Supported AI_PROVIDER values: openai, groq, deepseek, gemini, mock.
# Groq example: AI_PROVIDER=groq, AI_MODEL=openai/gpt-oss-120b,
# AI_BASE_URL=https://api.groq.com/openai/v1

# Reading text out of photographed or scanned reports (Tesseract OCR).
# Install the engine, then point this at the binary if it is not on PATH,
# e.g. C:/Program Files/Tesseract-OCR/tesseract.exe
TESSERACT_CMD=

# Live medical web search, so the assistant can cite current trusted pages where
# the built-in corpus is thin. It runs on every question, and results are kept
# only from WEB_SEARCH_ALLOWED_DOMAINS before they reach the AI - whatever the
# engine returns. Providers are tried left to right and the first one that
# answers wins, so either one may be left blank. Set WEB_SEARCH_PROVIDER= (empty)
# to disable live search and answer from the built-in corpus only.
#
# Google - Custom Search JSON API, 100 queries/day free, ~10 per request:
#   1. https://console.cloud.google.com -> APIs & Services -> enable
#      "Custom Search API" -> Credentials -> create an API key.
#   2. https://programmablesearchengine.google.com/controlpanel/create ->
#      "Search features" -> "Search only sites I have added to the list of sites",
#      then paste every domain from WEB_SEARCH_ALLOWED_DOMAINS below. That keeps
#      the results inside the trusted set instead of filtering away quota.
#   3. Copy the "search engine unique ID" (shaped like a1b2c3d4e5:6f7a8b) into
#      WEB_SEARCH_GOOGLE_ENGINE_ID.
#   Google returns short snippets rather than page text; Tavily returns more.
# Tavily - https://app.tavily.com -> API key.
#
# Restart the backend after editing this file; the autoreloader watches .py only.
WEB_SEARCH_PROVIDER=google,tavily
WEB_SEARCH_GOOGLE_API_KEY=
WEB_SEARCH_GOOGLE_ENGINE_ID=
WEB_SEARCH_API_KEY=
WEB_SEARCH_ALLOWED_DOMAINS=who.int,moh.gov.rw,rbc.gov.rw,rfd.gov.rw,cdc.gov,nih.gov,nhs.uk,mayoclinic.org,medlineplus.gov,ncbi.nlm.nih.gov,fda.gov,acr.org,nice.org.uk

# Embeddings / RAG (used from Phase 7)
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_BACKEND=pgvector

# Email / SMTP. Used to send password-reset verification codes.
# If EMAIL_HOST or EMAIL_HOST_PASSWORD is empty, Django falls back to the
# console backend and prints codes to the server log instead of emailing them.
#
# Verify any configuration with:
#   python manage.py check_email you@your-inbox.com
# It prints the SMTP transcript and distinguishes "relay accepted it" from
# "it reached the inbox". Restart runserver after editing this file - Django's
# autoreloader watches .py only, so a running server keeps the old backend.
#
# IMPORTANT: To avoid emails being flagged as spam, you MUST configure:
# 1. SPF record in your DNS (e.g., "v=spf1 include:your-smtp-provider.com ~all")
# 2. DKIM signing (configured in your email provider's dashboard)
# 3. DMARC policy (e.g., "v=DMARC1; p=none; rua=mailto:dmarc@yourdomain.com")
#
# --- Option A: Brevo (recommended; 300/day free, has delivery logs) ---------
# Create an account at https://www.brevo.com, then Transactional Email >
# Settings > SMTP & API > SMTP key > generate. Validate your sender address
# under Senders & Domains. EMAIL_HOST_PASSWORD is the SMTP key, NOT your
# Brevo account password. EMAIL_HOST_USER is your Brevo login email.
#
#   EMAIL_HOST=smtp-relay.brevo.com
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=true
#   EMAIL_HOST_USER=you@your-brevo-login.com
#   EMAIL_HOST_PASSWORD=your-brevo-smtp-key
#   DEFAULT_FROM_EMAIL=you@your-brevo-login.com
#
# --- Option B: Gmail ---------------------------------------------------------
# EMAIL_HOST_USER and DEFAULT_FROM_EMAIL must both be the Gmail account
# that authenticates, and EMAIL_HOST_PASSWORD must be a 16-character App
# Password (Google Account > Security > 2-Step Verification > App passwords).
# A normal Gmail password has been rejected since May 2022.
#
# Gmail works but is a poor fit for transactional mail: ~500/day cap, no
# delivery logs, and Google accepts messages at RCPT TO time that it then
# discards silently, so a 250 response does not prove the inbox exists.
# Brevo's dashboard shows why a message bounced; Gmail shows you nothing.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=your-sender@gmail.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=your-sender@gmail.com
EMAIL_TIMEOUT=30
EMAIL_HOSTNAME=

# Identity used inside the reset email. Setting SUPPORT_EMAIL also adds a
# List-Unsubscribe header, which Gmail and Yahoo treat as a trust signal.
SITE_URL=
SUPPORT_EMAIL=
